        "3": "Light Rain / Snow",
        "4": "Heavy Rain / Storm / Snow"
      }
    },
    "temp": {
      "type": "numeric",
      "range": [
        0.0,
        1.0
      ],
      "unit": "Normalized Celsius (real_celsius = temp * 41)"
    },
    "hum": {
      "type": "numeric",
      "range": [
        0.0,
        1.0
      ],
      "unit": "Normalized Humidity (real_percent = hum * 100)"
